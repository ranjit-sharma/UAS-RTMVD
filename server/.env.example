# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
# Comma-separated DNS servers for MongoDB Atlas SRV resolution
MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1

# JWT
JWT_SECRET=replace_with_a_strong_random_secret_min_32_chars
JWT_EXPIRES_IN=8h

# Cookie
COOKIE_NAME=uas_rtmvd_auth

# Client
CLIENT_URL=http://localhost:5173

# Simulator
SIMULATOR_INTERVAL_MS=3000

# Test DB (used only by test suite; use a separate Atlas database)
MONGODB_URI_TEST=mongodb+srv://<username>:<password>@<cluster-host>/uas_rtmvd_test?retryWrites=true&w=majority
